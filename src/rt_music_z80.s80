; Rolling Thunder MD -- Z80 music driver.
; Port of the native source sequencer (music_sequence.c, music_control.c,
; music_clock.c, music_registers.c) and the YM2151 -> YM2612/PSG translation
; (opn_music.c). The 68000 only posts commands in the mailbox at $1F00.
; Music data + translation tables: tools/audio/build_music_z80_blob.c, read
; through the 32 KB bank window ($8000). Clock: YM2612 Timer A at the DAC
; rate, 10 x 18.77 us = 5326.7 Hz. Timer B (300.4 us) is the time reference:
; it adds 16/10 samples to OWED, so a late poll drops samples instead of
; slowing playback, and every 55th tick is a music service (60.53 Hz).
; Samples: the arcade 63701X's two lanes (sound bytes: bit 5 lane, bit 6 bank
; 0/2, bits 0-4 clip), mixed on the YM2612 DAC (channel 6) from RAM buffers
; refilled from rtVoiceZ80Blob (tools/audio/build_voice_z80_blob.py).

YM_A0       EQU $4000
YM_D0       EQU $4001
YM_A1       EQU $4002
YM_D1       EQU $4003
BANKREG     EQU $6000
PSGPORT     EQU $7F11

; ---- mailbox (68000 <-> Z80)
CMDTRACK    EQU $1F00           ; 0 stop, 1..13 play
CMDSEQ      EQU $1F01           ; 68000 bumps to post CMDTRACK
CMDPSG      EQU $1F02           ; nonzero: silence PSG-routed parts
BANKLO      EQU $1F04           ; blob address >> 15, low 8 bits
BANKHI      EQU $1F05           ; bit 8
BANKOK      EQU $1F06           ; $5A once BANKLO/HI are valid
STATOUT     EQU $1F08           ; 1 while a track is sounding
ALIVE       EQU $1F09           ; service counter (word)
VBANKLO     EQU $1F0C           ; voice blob address >> 15, low 8 bits
VBANKHI     EQU $1F0D           ; bit 8
SFXRING     EQU $1F10           ; 16 sound bytes posted by the 68000
SFXWR       EQU $1F20           ; 68000 write index (mod 16)
PROTECT     EQU $1F30           ; 68000: a DMA is about to run / running
PROTACK     EQU $1F31           ; Z80: parked, no ROM access until PROTECT clears

; ---- per-source records: 32 bytes at SRC + source*32
SRC         EQU $1800
F_RL        EQU 0
F_KC        EQU 1
F_KF        EQU 2
F_PMSAMS    EQU 3
F_STAGE     EQU 4
F_TL        EQU 5
F_D1R       EQU 6
F_D2R       EQU 7
F_D1LRR     EQU 8
F_PSGATT    EQU 9
F_ENV       EQU 10              ; word
F_DT1MUL    EQU 12              ; 4 bytes
F_DT2       EQU 16              ; 4 bytes
F_TGT       EQU 21              ; 0..5 FM, 16..18 PSG, $FF muted

; ---- translator globals
MAP         EQU $1900           ; 8
PENDON      EQU $1908           ; 6 pending key-on slot masks
OFFMASK     EQU $190E
SETTLED     EQU $190F
LFRQ        EQU $1910
PMD         EQU $1911
AMD         EQU $1912
PSGOFF      EQU $1913
ACTIVE      EQU $1914
IDLEDONE    EQU $1915
LASTSEQ     EQU $1916
REQTRACK    EQU $1917
; ---- sequencer state (cleared on every track start)
SEQSTART    EQU $1918
STATUS      EQU $1918
CURSOR      EQU $1919           ; word
RETCUR      EQU $191B           ; word
RETDEPTH    EQU $191D
LASTLOOP    EQU $191E
FRAC        EQU $1920           ; word
BASE        EQU $1922
MULT        EQU $1923
MGAIN       EQU $1924
CHGAIN      EQU $1928           ; 8
LOOPCNT     EQU $1930           ; 8
LOOPKEY     EQU $1938           ; 8 words
SEQLEN      EQU $1948-SEQSTART
; ---- blob header copy (pointers into $8000 window)
HDR         EQU $1950
H_EVENTS    EQU HDR+0
H_DATA      EQU HDR+2
H_PATCHES   EQU HDR+4
H_TRACKS    EQU HDR+6
H_FN        EQU HDR+8
H_PSG       EQU HDR+10
H_DT2MUL    EQU HDR+12
H_DECAY     EQU HDR+14
H_REL       EQU HDR+16
H_LFO       EQU HDR+18
H_FMS       EQU HDR+20
H_AMS       EQU HDR+22
H_TL38      EQU HDR+24
H_MAPS      EQU HDR+26
H_DT2P      EQU HDR+28
H_EVCOUNT   EQU HDR+30
TRACKCOUNT  EQU 38
; ---- scratch
EVB0        EQU $1980
EVMASK      EQU $1981
EVVAL       EQU $1982
EVIDX       EQU $1983
EVIDXW      EQU $1984           ; word
EVDATA      EQU $1986           ; word
BUDGET      EQU $1988           ; word
OPKIND      EQU $198A
PIDX        EQU $198C           ; word
POCT        EQU $198E
PBASE       EQU $1990           ; word
PBOCT       EQU $1992
FHI         EQU $1993
FLO         EQU $1994
FPORT       EQU $1995
FVHI        EQU $1996
FVLO        EQU $1997
CHN         EQU $1998
PATCHPTR    EQU $199A           ; word
RKEY        EQU $199C           ; word
RFIRST      EQU $199E           ; word
RREPEAT     EQU $19A0           ; word
RFOUND      EQU $19A2
RCOND       EQU $19A3
CURBANK     EQU $19A4           ; word: bank now mapped at $8000
BLOBBANK    EQU $19A6           ; word: music blob bank
VBASE       EQU $19A8           ; word: voice blob bank
TICKACC     EQU $19AA           ; word
TICKDUE     EQU $19AC
SFXRD       EQU $19AD
TRIG        EQU $19AE           ; scratch: sound byte
; sample lanes: 16 bytes each; buffers are 256-byte pages
LANE0       EQU $19C0
LANE1       EQU $19D0
L_CNT       EQU 0               ; bytes buffered (<= 255)
L_RD        EQU 1               ; read index
L_PAGE      EQU 2               ; buffer page (high byte)
L_WR        EQU 3               ; write index
L_ACTIVE    EQU 4
L_REMAIN    EQU 5               ; word: bytes still in ROM
L_BANK      EQU 7               ; word
L_OFF       EQU 9               ; word: window address $8000..$FFFF
BUF0        EQU $1A00
BUF1        EQU $1B00
MIXBUF      EQU $1C00           ; premixed DAC samples (unsigned)
MIXCNT      EQU $19B4
MIXRD       EQU $19B5
MIXWR       EQU $19B6
MIXN        EQU $19B7           ; scratch: samples in this mixer step
MIXAHEAD    EQU 64              ; mix at most 11 ms ahead (trigger latency)
OWED        EQU $19B0           ; word, signed 8.8: samples due minus played
BTICKS      EQU $19B2           ; Timer B ticks toward the next music service
BSTEP       EQU 410             ; 16/10 samples per Timer B tick, 8.8
ACNT        EQU $19B3           ; Timer A samples since the last Timer B tick
ENVMAX      EQU 12288

; ===========================================================================
            ORG     $0000
            DI
            JP      init

            BLOCK   $0038-$
            RETI                    ; interrupts stay disabled

init
            LD      SP, $1F00
            IM      1
            XOR     A
            LD      (ACTIVE), A
            LD      (LASTSEQ), A
            LD      (STATOUT), A
            LD      (PSGOFF), A
            LD      HL, 0
            LD      (ALIVE), HL
wait_bank
            LD      A, (BANKOK)
            CP      $5A
            JR      NZ, wait_bank
            LD      A, (BANKLO)
            LD      L, A
            LD      A, (BANKHI)
            AND     1
            LD      H, A
            LD      (BLOBBANK), HL
            LD      A, (VBANKLO)
            LD      E, A
            LD      A, (VBANKHI)
            AND     1
            LD      D, A
            LD      (VBASE), DE
            LD      A, $FF          ; force the first bank write
            LD      (CURBANK+1), A
            CALL    setbank
            XOR     A
            LD      (TICKDUE), A
            LD      (SFXRD), A
            LD      HL, 0
            LD      (TICKACC), HL
            LD      (OWED), HL
            LD      (BTICKS), A
            LD      (ACNT), A
            LD      (MIXWR), A
            EXX                     ; spare set: B' mix count, C' samples,
            LD      BC, 0           ; DE' mix read pointer
            LD      DE, MIXBUF
            EXX
            LD      HL, LANE0       ; both lane records + idle
            LD      B, 32
in_lane
            LD      (HL), A
            INC     HL
            DJNZ    in_lane
            LD      A, BUF0>>8
            LD      (LANE0+L_PAGE), A
            LD      A, BUF1>>8
            LD      (LANE1+L_PAGE), A
            ; header -> RAM
            LD      HL, $8000
            LD      DE, HDR
            LD      BC, 32
            LDIR
            ; translator to a known silent state (any map)
            LD      HL, (H_MAPS)
            LD      DE, MAP
            LD      BC, 8
            LDIR
            CALL    reset
            ; Timer A = 1014 (5326.7 Hz DAC clock)
            LD      D, $24
            LD      E, 253
            CALL    ymw0
            LD      D, $25
            LD      E, 2
            CALL    ymw0
            LD      D, $26          ; Timer B = 255 (300.4 us)
            LD      E, 255
            CALL    ymw0
            LD      D, $27
            LD      E, $7F          ; ch3 special, load+enable A and B, clear flags
            CALL    ymw0
            JP      main_loop

main_loop
            LD      A, (CMDSEQ)
            LD      HL, LASTSEQ
            CP      (HL)
            JR      Z, ml_nocmd
            LD      (HL), A
            CALL    command
ml_nocmd
            LD      A, (CMDPSG)
            OR      A
            JR      Z, ml_psg
            LD      A, 15
ml_psg
            LD      (PSGOFF), A
            CALL    dac_poll
            CALL    sfx_ring
            CALL    dac_poll
            LD      HL, LANE0
            CALL    refill
            CALL    dac_poll
            LD      HL, LANE1
            CALL    refill
            CALL    mixer
            LD      A, (TICKDUE)    ; music services owed (counted by dac_poll)
            OR      A
            JP      Z, main_loop
            DEC     A
            LD      (TICKDUE), A
            LD      A, (ACTIVE)
            OR      A
            JR      Z, ml_out
            CALL    service
            CALL    tick
            LD      HL, (ALIVE)
            INC     HL
            LD      (ALIVE), HL
ml_out
            CALL    dac_poll
            LD      A, (ACTIVE)
            OR      A
            JR      Z, ml_stat
            LD      A, (STATUS)
            OR      A
            JR      Z, ml_stat
            LD      A, 1
ml_stat
            LD      (STATOUT), A
            JP      main_loop

; ---- 68000 command ---------------------------------------------------------
command
            LD      A, (CMDTRACK)
            OR      A
            JR      NZ, cm_play
            LD      A, (ACTIVE)
            OR      A
            RET     Z
            XOR     A
            LD      (ACTIVE), A
            JP      silence
cm_play
            LD      (REQTRACK), A
            CP      14
            JR      C, cm_map
            LD      A, 6
cm_map
            ADD     A, A
            ADD     A, A
            ADD     A, A
            LD      E, A
            LD      D, 0
            LD      HL, (H_MAPS)
            ADD     HL, DE
            LD      DE, MAP
            LD      BC, 8
            LDIR
            CALL    reset
            LD      HL, SEQSTART
            LD      DE, SEQSTART+1
            LD      BC, SEQLEN-1
            LD      (HL), 0
            LDIR
            LD      A, (REQTRACK)
            LD      (STATUS), A
            XOR     A
            LD      (IDLEDONE), A
            INC     A
            LD      (ACTIVE), A
            RET

; ---- chip access -----------------------------------------------------------
; D = register, E = value
ymw0
            CALL    dac_poll
ymw0_w
            LD      A, (YM_A0)
            ADD     A, A
            JR      C, ymw0_w
            LD      A, D
            LD      (YM_A0), A
            LD      A, E
            LD      (YM_D0), A
            RET
ymw1
            CALL    dac_poll
ymw1_w
            LD      A, (YM_A0)
            ADD     A, A
            JR      C, ymw1_w
            LD      A, D
            LD      (YM_A1), A
            LD      A, E
            LD      (YM_D1), A
            RET
; C = FM channel 0..5, D = register base, E = value. Keeps BC.
fmw
            LD      A, C
            CP      3
            JR      NC, fmw_p1
            ADD     A, D
            LD      D, A
            JR      ymw0
fmw_p1
            SUB     3
            ADD     A, D
            LD      D, A
            JR      ymw1
psgw
            LD      (PSGPORT), A
            RET
; C = FM channel -> A = key-on channel code
keycode
            LD      A, C
            CP      3
            RET     C
            INC     A
            RET
; A = n -> A = 1 << n
bitmask
            PUSH    BC
            LD      B, A
            LD      A, 1
            INC     B
            JR      bm_2
bm_1
            ADD     A, A
bm_2
            DJNZ    bm_1
            POP     BC
            RET
; A = source -> IX = record
srcix
            RRCA
            RRCA
            RRCA
            PUSH    HL
            LD      L, A
            LD      H, SRC>>8
            PUSH    HL
            POP     IX
            POP     HL
            RET
; HL = IX + A
ixfield
            PUSH    IX
            POP     HL
            ADD     A, L
            LD      L, A
            RET
; HL = A * E (8x8 unsigned)
mul8
            LD      H, A
            LD      L, 0
            LD      D, 0
            LD      B, 8
mul_l
            ADD     HL, HL
            JR      NC, mul_n
            ADD     HL, DE
mul_n
            DJNZ    mul_l
            RET
settle
            PUSH    BC
            LD      B, 40
st_l
            DJNZ    st_l
            POP     BC
            RET

; ---- samples ---------------------------------------------------------------
; Wait for YM2612 ready.
ybusy
            LD      A, (YM_A0)
            ADD     A, A
            JR      C, ybusy
            RET
; Called between operations (never inside a ROM access). PROTECT parks the
; driver here, still mixing from RAM, until the 68000's DMA is done.
; On each Timer A overflow: rearm, mix both lanes to the DAC, advance the
; music accumulator. Keeps every register. Never touches ROM.
; One Timer A event (plus any Timer B tick seen with it), in the spare set.

dac_poll
            LD      A, (YM_A0)      ; fast path: Timer A only
            RRCA
            RET     NC
            EX      AF, AF'         ; spare register set: the rest of the
            EXX                     ; driver never uses it
            LD      A, (YM_A0)
            AND     3
            CP      1
            CALL    NZ, dp_both     ; Timer B seen too (one in ~1.8)
            LD      A, $27          ; ch3 special, both timers run; clear A flag
            LD      (YM_A0), A
            LD      A, $5F
            LD      (YM_D0), A
            INC     C               ; C' = samples since the last Timer B tick
            LD      A, B            ; B' = premixed samples buffered
            OR      A
            LD      A, $80          ; underrun: silence
            JR      Z, ds_out_p
            DEC     B
            LD      A, (DE)         ; DE' = MIXBUF read pointer
            INC     E
ds_out_p
            LD      L, A            ; >100 cycles since the $27 data write
            LD      A, $2A
            LD      (YM_A0), A
            LD      A, L
            LD      (YM_D0), A
            LD      A, (PROTECT)
            OR      A
            JR      NZ, dp_park
dp_ret
            EXX
            EX      AF, AF'
            RET
dp_park
            LD      A, 1            ; parked: no ROM access until PROTECT clears
            LD      (PROTACK), A
dp_pw
            LD      A, (YM_A0)
            RRCA
            CALL    C, dp_sample
            LD      A, (PROTECT)
            OR      A
            JR      NZ, dp_pw
            LD      (PROTACK), A
            ; A new DMA can raise PROTECT after the zero read above but
            ; before ACK clears. Recheck before leaving RAM-only playback:
            ; the 68000 may have accepted that still-high ACK for its DMA.
            LD      A, (PROTECT)
            OR      A
            JR      NZ, dp_park
            JR      dp_ret
dp_sample
            LD      A, (YM_A0)
            AND     3
            CP      1
            CALL    NZ, dp_both     ; Timer B seen too (one in ~1.8)
            LD      A, $27          ; ch3 special, both timers run; clear A flag
            LD      (YM_A0), A
            LD      A, $5F
            LD      (YM_D0), A
            INC     C               ; C' = samples since the last Timer B tick
            LD      A, B            ; B' = premixed samples buffered
            OR      A
            LD      A, $80          ; underrun: silence
            JR      Z, ds_out_s
            DEC     B
            LD      A, (DE)         ; DE' = MIXBUF read pointer
            INC     E
ds_out_s
            LD      L, A            ; >100 cycles since the $27 data write
            LD      A, $2A
            LD      (YM_A0), A
            LD      A, L
            LD      (YM_D0), A
            RET
; Timer B overflow seen with Timer A: clear B, then account for it.
dp_both
            LD      A, $27
            LD      (YM_A0), A
            LD      A, $6F          ; clear B flag (A is cleared by the caller)
            LD      (YM_D0), A
; Timer B tick (spare set): music clock, and reconcile samples played (C')
; against time (16/10 per tick). Two or more behind: drop one premixed sample.
dp_btick
            LD      HL, BTICKS
            INC     (HL)
            LD      A, (HL)
            CP      55
            JR      C, bt_time
            LD      (HL), 0
            LD      HL, TICKDUE     ; music services owed
            INC     (HL)
bt_time
            PUSH    DE
            LD      HL, (OWED)
            LD      DE, BSTEP
            ADD     HL, DE
            POP     DE
            LD      A, H
            SUB     C
            LD      H, A
            LD      C, 0
            JP      M, bt_neg
            CP      2
            JR      C, bt_store
            DEC     H               ; two or more behind: drop one
            LD      (OWED), HL
            LD      A, B
            OR      A
            RET     Z
            DEC     B
            INC     E
            RET
bt_neg
            CP      $FC             ; far ahead (rounding drift): resync
            JR      NC, bt_store
            LD      HL, 0
bt_store
            LD      (OWED), HL
            RET
; HL = bank number -> mapped at $8000 (9 bits, LSB first)
setbank
            LD      DE, (CURBANK)
            LD      A, L
            CP      E
            JR      NZ, sb_go
            LD      A, H
            CP      D
            RET     Z
sb_go
            LD      (CURBANK), HL
            LD      DE, BANKREG
            LD      A, L
            LD      (DE), A
            RRCA
            LD      (DE), A
            RRCA
            LD      (DE), A
            RRCA
            LD      (DE), A
            RRCA
            LD      (DE), A
            RRCA
            LD      (DE), A
            RRCA
            LD      (DE), A
            RRCA
            LD      (DE), A
            LD      A, H
            LD      (DE), A
            RET

; Drain the 68000 sound-byte ring.
sfx_ring
            LD      A, (SFXRD)
            LD      HL, SFXWR
            CP      (HL)
            RET     Z
            LD      E, A
            INC     A
            AND     15
            LD      (SFXRD), A
            LD      A, E
            AND     15
            ADD     A, SFXRING&255
            LD      L, A
            LD      H, SFXRING>>8
            LD      A, (HL)
            OR      A
            CALL    NZ, trigger
            CALL    dac_poll
            JR      sfx_ring

; A = sound byte: restart its lane with the clip (bank-0/2 table lookup).
trigger
            LD      (TRIG), A
            AND     $40
            RRCA                    ; bank 2 -> 32
            LD      B, A
            LD      A, (TRIG)
            AND     $1F
            OR      B               ; table index 0..63
            LD      L, A
            LD      H, 0
            LD      E, L
            LD      D, H
            ADD     HL, HL
            ADD     HL, HL
            ADD     HL, DE          ; *5
            LD      DE, $8000
            ADD     HL, DE
            PUSH    HL
            CALL    dac_poll
            LD      HL, (VBASE)
            CALL    setbank
            POP     HL
            LD      C, (HL)         ; offset bits 0-7
            INC     HL
            LD      B, (HL)         ; 8-15
            INC     HL
            LD      A, (HL)         ; 16-23
            INC     HL
            LD      E, (HL)
            INC     HL
            LD      D, (HL)         ; length
            PUSH    AF
            PUSH    DE
            LD      HL, (BLOBBANK)
            CALL    setbank
            CALL    dac_poll
            POP     DE
            LD      A, D
            OR      E
            JR      NZ, tr_ok
            POP     AF
            RET
tr_ok
            POP     AF
            ; bank = VBASE + (offset >> 15); window = $8000 | (offset & $7FFF)
            LD      H, A
            LD      L, B
            ADD     HL, HL          ; bit 15 of B into H:L >> 7 trick
            LD      L, H            ; L = offset >> 15 (low 8 bits)
            LD      H, 0
            PUSH    DE
            LD      DE, (VBASE)
            ADD     HL, DE
            POP     DE
            PUSH    HL              ; bank
            LD      A, B
            OR      $80
            LD      B, A            ; window address in BC
            LD      HL, LANE0
            LD      A, (TRIG)
            AND     $20
            JR      Z, tr_lane
            LD      HL, LANE1
tr_lane
            XOR     A
            LD      (HL), A         ; L_CNT
            INC     HL
            LD      (HL), A         ; L_RD
            INC     HL
            INC     HL
            LD      (HL), A         ; L_WR
            INC     HL
            LD      (HL), 1         ; L_ACTIVE
            INC     HL
            LD      (HL), E         ; L_REMAIN
            INC     HL
            LD      (HL), D
            INC     HL
            POP     DE
            LD      (HL), E         ; L_BANK
            INC     HL
            LD      (HL), D
            INC     HL
            LD      (HL), C         ; L_OFF
            INC     HL
            LD      (HL), B
            RET

; HL = lane: top the RAM buffer up from ROM. The lane's ROM pointer (HL),
; buffer write pointer (DE) and remaining length (BC) stay in registers; the
; DAC poll between chunks only uses the spare register set and A. Unrolled
; 16-byte chunks; single bytes only at clip ends and bank-window edges.
; The music bank is restored before returning.
refill
            PUSH    HL
            POP     IY
            LD      A, (IY+L_ACTIVE)
            OR      A
            RET     Z
            LD      C, (IY+L_REMAIN)
            LD      B, (IY+L_REMAIN+1)
            LD      A, B
            OR      C
            JR      NZ, rf_need
            LD      A, (IY+L_CNT)   ; ROM done: idle once drained
            OR      A
            RET     NZ
            LD      (IY+L_ACTIVE), A
            RET
rf_need
            LD      A, (IY+L_CNT)
            CP      176
            RET     NC
            PUSH    BC
            LD      L, (IY+L_BANK)
            LD      H, (IY+L_BANK+1)
            CALL    setbank
            POP     BC
            LD      L, (IY+L_OFF)
            LD      H, (IY+L_OFF+1)
            LD      E, (IY+L_WR)
            LD      D, (IY+L_PAGE)
rf_loop
            CALL    dac_poll
            LD      A, (IY+L_CNT)
            CP      176
            JP      NC, rf_store
            LD      A, B            ; 16 or more left in the clip?
            OR      A
            JR      NZ, rf_w16
            LD      A, C
            CP      16
            JR      C, rf_one
rf_w16
            LD      A, H            ; at least 16 left in the window?
            CP      $FF
            JR      NZ, rf_fast
            LD      A, L
            CP      $F1
            JR      NC, rf_one
rf_fast
            LD      A, (HL)
            LD      (DE), A
            INC     HL
            INC     E
            LD      A, (HL)
            LD      (DE), A
            INC     HL
            INC     E
            LD      A, (HL)
            LD      (DE), A
            INC     HL
            INC     E
            LD      A, (HL)
            LD      (DE), A
            INC     HL
            INC     E
            CALL    dac_poll
            LD      A, (HL)
            LD      (DE), A
            INC     HL
            INC     E
            LD      A, (HL)
            LD      (DE), A
            INC     HL
            INC     E
            LD      A, (HL)
            LD      (DE), A
            INC     HL
            INC     E
            LD      A, (HL)
            LD      (DE), A
            INC     HL
            INC     E
            CALL    dac_poll
            LD      A, (HL)
            LD      (DE), A
            INC     HL
            INC     E
            LD      A, (HL)
            LD      (DE), A
            INC     HL
            INC     E
            LD      A, (HL)
            LD      (DE), A
            INC     HL
            INC     E
            LD      A, (HL)
            LD      (DE), A
            INC     HL
            INC     E
            CALL    dac_poll
            LD      A, (HL)
            LD      (DE), A
            INC     HL
            INC     E
            LD      A, (HL)
            LD      (DE), A
            INC     HL
            INC     E
            LD      A, (HL)
            LD      (DE), A
            INC     HL
            INC     E
            LD      A, (HL)
            LD      (DE), A
            INC     HL
            INC     E
            LD      A, C
            SUB     16
            LD      C, A
            JR      NC, rf_b16
            DEC     B
rf_b16
            LD      A, (IY+L_CNT)
            ADD     A, 16
            LD      (IY+L_CNT), A
            JR      rf_edge
rf_one
            LD      A, B
            OR      C
            JR      Z, rf_store     ; clip fully buffered
            LD      A, (HL)
            LD      (DE), A
            INC     HL
            INC     E
            DEC     BC
            INC     (IY+L_CNT)
rf_edge
            CALL    dac_poll
            LD      A, H            ; crossed $FFFF: next 32 KB bank
            OR      L
            JP      NZ, rf_loop
            PUSH    BC
            PUSH    DE
            LD      L, (IY+L_BANK)
            LD      H, (IY+L_BANK+1)
            INC     HL
            LD      (IY+L_BANK), L
            LD      (IY+L_BANK+1), H
            CALL    setbank
            POP     DE
            POP     BC
            LD      HL, $8000
            JP      rf_loop
rf_store
            LD      (IY+L_OFF), L
            LD      (IY+L_OFF+1), H
            LD      (IY+L_WR), E
            LD      (IY+L_REMAIN), C
            LD      (IY+L_REMAIN+1), B
            LD      HL, (BLOBBANK)
            JP      setbank

; Premix both lanes into MIXBUF, 16 samples at a time, while it holds
; fewer than MIXAHEAD. An active lane with nothing buffered yet makes the
; mixer wait (its refill follows); finished lanes are retired by refill.
mixer
            CALL    dac_poll
            EXX
            LD      A, B            ; B' = buffered premixed samples
            EXX
            CP      MIXAHEAD
            RET     NC
            LD      B, 16
            LD      C, 0            ; C bit0 lane0, bit1 lane1
            LD      A, (LANE0+L_ACTIVE)
            OR      A
            JR      Z, mx_n0
            LD      A, (LANE0+L_CNT)
            OR      A
            RET     Z               ; wait for lane 0 data
            SET     0, C
            CP      B
            JR      NC, mx_n0
            LD      B, A
mx_n0
            LD      A, (LANE1+L_ACTIVE)
            OR      A
            JR      Z, mx_n1
            LD      A, (LANE1+L_CNT)
            OR      A
            RET     Z               ; wait for lane 1 data
            SET     1, C
            CP      B
            JR      NC, mx_n1
            LD      B, A
mx_n1
            LD      A, C
            OR      A
            RET     Z               ; nothing playing
            LD      (MIXN), A       ; lanes mask (reused below)
            LD      A, B
            LD      (MIXN+1), A     ; count
            LD      A, (LANE0+L_RD)
            LD      L, A
            LD      H, BUF0>>8
            LD      A, (LANE1+L_RD)
            LD      E, A
            LD      D, BUF1>>8
            LD      A, (MIXWR)
            LD      C, A
            CALL    dac_poll
            LD      A, B
            LD      B, MIXBUF>>8
            CP      16
            JP      NZ, mx_slow
            LD      A, (MIXN)
            CP      3
            JP      Z, mx_both
            CP      1
            JP      Z, mx_l0
mx_l1
