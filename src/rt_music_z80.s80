            JP      mx_done
mx_slow                             ; fewer than 16 (clip ends)
            LD      A, (MIXN)
            CP      3
            JR      Z, mxs_both
            CP      1
            JR      Z, mxs_l0
mxs_l1
            LD      A, (DE)
            LD      (BC), A
            INC     E
            INC     C
            LD      A, (MIXN+1)
            DEC     A
            LD      (MIXN+1), A
            JR      NZ, mxs_l1
            JR      mx_done
mxs_l0
            LD      A, (HL)
            LD      (BC), A
            INC     L
            INC     C
            LD      A, (MIXN+1)
            DEC     A
            LD      (MIXN+1), A
            JR      NZ, mxs_l0
            JR      mx_done
mxs_both
            LD      A, (DE)
            ADD     A, (HL)
            JR      C, mxs_h
            SUB     $80
            JR      NC, mxs_s
            XOR     A
            JR      mxs_s
mxs_h
            ADD     A, $80
            JR      NC, mxs_s
            LD      A, $FF
mxs_s
            LD      (BC), A
            INC     L
            INC     E
            INC     C
            LD      A, (MIXN+1)
            DEC     A
            LD      (MIXN+1), A
            JR      NZ, mxs_both
mx_done
            CALL    dac_poll
            ; recount from the pointers moved: n = new MIXWR - old MIXWR
            LD      A, (MIXWR)
            LD      B, A
            LD      A, C
            LD      (MIXWR), A
            SUB     B               ; n
            LD      B, A
            LD      A, (MIXN)
            BIT     0, A
            JR      Z, mxd_1
            LD      A, L
            LD      (LANE0+L_RD), A
            LD      A, (LANE0+L_CNT)
            SUB     B
            LD      (LANE0+L_CNT), A
mxd_1
            LD      A, (MIXN)
            BIT     1, A
            JR      Z, mxd_2
            LD      A, E
            LD      (LANE1+L_RD), A
            LD      A, (LANE1+L_CNT)
            SUB     B
            LD      (LANE1+L_CNT), A
mxd_2
            LD      A, B
            EXX
            ADD     A, B
            LD      B, A
            EXX
            JP      mixer

; ---- translator: reset / silence / tick ------------------------------------
reset
            LD      B, 0
rs_src
            LD      A, B
            CALL    srcix
            PUSH    IX
            POP     HL
            LD      E, 32
rs_clr
            LD      (HL), 0
            INC     HL
            DEC     E
            JR      NZ, rs_clr
            LD      (IX+F_TL), $7F
            LD      (IX+F_PSGATT), $FF
            LD      HL, MAP
            LD      A, L
            ADD     A, B
            LD      L, A
            LD      A, (HL)
            LD      (IX+F_TGT), A
            INC     B
            LD      A, B
            CP      8
            JR      NZ, rs_src
            XOR     A
            LD      (LFRQ), A
            LD      (PMD), A
            LD      (AMD), A
            LD      (OFFMASK), A
            LD      HL, PENDON
            LD      B, 6
rs_pend
            LD      (HL), A
            INC     HL
            DJNZ    rs_pend
            LD      DE, $2200
            CALL    ymw0
            LD      DE, $274F       ; ch3 special, both timers running
            CALL    ymw0
            LD      DE, $2B80       ; DAC on (channel 6 is the sample mixer)
            CALL    ymw0
            LD      DE, $B6C0       ; channel 6 output left+right
            CALL    ymw1
            LD      C, 0
rs_ch
            CALL    keycode
            LD      E, A
            LD      D, $28
            CALL    ymw0
            LD      B, 0
rs_op
            LD      A, $40
            ADD     A, B
            LD      D, A
            LD      E, $7F
            CALL    fmw
            LD      A, $80
            ADD     A, B
            LD      D, A
            LD      E, $FF
            CALL    fmw
            LD      A, $90
            ADD     A, B
            LD      D, A
            LD      E, 0
            CALL    fmw
            LD      A, B
            ADD     A, 4
            LD      B, A
            CP      16
            JR      NZ, rs_op
            LD      DE, $B400
            CALL    fmw
            INC     C
            LD      A, C
            CP      5               ; channel 6 stays the DAC
            JR      NZ, rs_ch
            LD      A, $9F
            CALL    psgw
            LD      A, $BF
            CALL    psgw
            LD      A, $DF
            CALL    psgw
            LD      A, $FF
            JP      psgw

silence
            XOR     A
            LD      (OFFMASK), A
            LD      HL, PENDON
            LD      B, 6
si_pend
            LD      (HL), A
            INC     HL
            DJNZ    si_pend
            LD      B, 0
si_src
            PUSH    BC
            LD      A, B
            CALL    srcix
            LD      A, (IX+F_TGT)
            CP      6
            JR      NC, si_psg
            LD      C, A
            CALL    keycode
            LD      E, A
            LD      D, $28
            CALL    ymw0
            LD      B, 0
si_op
            LD      A, $80
            ADD     A, B
            LD      D, A
            LD      E, $FF
            CALL    fmw
            LD      A, $40
            ADD     A, B
            LD      D, A
            LD      E, $7F
            CALL    fmw
            LD      A, B
            ADD     A, 4
            LD      B, A
            CP      16
            JR      NZ, si_op
            JR      si_next
si_psg
            CP      $FF
            JR      Z, si_next
            LD      (IX+F_STAGE), 0
            CALL    psglevel
si_next
            POP     BC
            INC     B
            LD      A, B
            CP      8
            JR      NZ, si_src
            RET

; Issues queued key-ons (after a settle if the channel was keyed off this
; service), then advances PSG envelopes. Once per source service.
tick
            XOR     A
            LD      (SETTLED), A
            LD      C, 0
tk_ch
            LD      HL, PENDON
            LD      A, L
            ADD     A, C
            LD      L, A
            LD      A, (HL)
            OR      A
            JR      Z, tk_next
            LD      B, A
            LD      (HL), 0
            LD      A, (SETTLED)
            OR      A
            JR      NZ, tk_go
            LD      A, C
            CALL    bitmask
            LD      HL, OFFMASK
            AND     (HL)
            JR      Z, tk_go
            CALL    settle
            LD      A, 1
            LD      (SETTLED), A
tk_go
            LD      A, B
            RLCA
            RLCA
            RLCA
            RLCA
            AND     $F0
            LD      B, A
            CALL    keycode
            OR      B
            LD      E, A
            LD      D, $28
            CALL    ymw0
tk_next
            INC     C
            LD      A, C
            CP      6
            JR      NZ, tk_ch
            XOR     A
            LD      (OFFMASK), A
            LD      B, 0
te_src
            CALL    dac_poll
            LD      A, B
            CALL    srcix
            LD      A, (IX+F_TGT)
            CP      16
            JP      C, te_next
            CP      $FF
            JP      Z, te_next
            LD      A, (IX+F_STAGE)
            OR      A
            JP      Z, te_next
            PUSH    BC
            CP      1
            JR      NZ, te_s2
            LD      A, (IX+F_D1R)
            JR      te_dec
te_s2
            CP      2
            JR      NZ, te_s3
            LD      A, (IX+F_D2R)
te_dec
            ADD     A, A
            LD      E, A
            LD      D, 0
            LD      HL, (H_DECAY)
            JR      te_get
te_s3
            LD      A, (IX+F_D1LRR)
            AND     15
            ADD     A, A
            LD      E, A
            LD      D, 0
            LD      HL, (H_REL)
te_get
            ADD     HL, DE
            LD      E, (HL)
            INC     HL
            LD      D, (HL)
            LD      L, (IX+F_ENV)
            LD      H, (IX+F_ENV+1)
            ADD     HL, DE
            LD      A, (IX+F_STAGE)
            CP      1
            JR      NZ, te_max
            LD      A, (IX+F_D1LRR)
            RRCA
            RRCA
            RRCA
            RRCA
            AND     15
            CP      15
            JR      Z, te_susmax
            PUSH    HL
            LD      D, A            ; sustain = level*384
            LD      H, A
            LD      L, 0
            SRL     H
            RR      L
            LD      A, D
            ADD     A, H
            LD      H, A
            EX      DE, HL
            POP     HL
            JR      te_cmp
te_susmax
            LD      DE, ENVMAX
te_cmp
            OR      A
            SBC     HL, DE
            ADD     HL, DE
            JR      C, te_max
            LD      H, D
            LD      L, E
            LD      (IX+F_STAGE), 2
te_max
            LD      DE, ENVMAX
            OR      A
            SBC     HL, DE
            ADD     HL, DE
            JR      C, te_store
            LD      H, D
            LD      L, E
            LD      A, (IX+F_STAGE)
            CP      3
            JR      NZ, te_store
            LD      (IX+F_STAGE), 0
te_store
            CALL    dac_poll
            LD      (IX+F_ENV), L
            LD      (IX+F_ENV+1), H
            CALL    psglevel
            POP     BC
te_next
            INC     B
            LD      A, B
            CP      8
            JP      NZ, te_src
            RET

; ---- translator: helpers on IX source --------------------------------------
psglevel
            CALL    dac_poll
            LD      E, 15
            LD      A, (IX+F_STAGE)
            OR      A
            JR      Z, pl_set
            LD      A, (IX+F_RL)
            AND     $C0
            JR      Z, pl_set
            LD      A, (IX+F_TL)
            LD      L, A
            LD      H, 0
            LD      DE, (H_TL38)
            ADD     HL, DE
            LD      A, (HL)
            ADD     A, (IX+F_ENV+1)
            LD      E, A
            LD      A, (PSGOFF)
            ADD     A, E
            CP      16
            JR      C, pl_ok
            LD      A, 15
pl_ok
            LD      E, A
pl_set
            LD      A, (IX+F_PSGATT)
            CP      E
            RET     Z
            LD      (IX+F_PSGATT), E
            LD      A, (IX+F_TGT)
            SUB     16
            RRCA
            RRCA
            RRCA
            OR      $90
            OR      E
            JP      psgw

; C = target. Keeps B.
fmpan
            CALL    dac_poll
            PUSH    BC
            LD      A, (IX+F_PMSAMS)
            RRCA
            RRCA
            RRCA
            RRCA
            AND     7
            LD      H, A
            LD      L, 0
            SRL     H
            RR      L
            LD      A, (PMD)
            ADD     A, L
            LD      L, A
            LD      DE, (H_FMS)
            ADD     HL, DE
            LD      B, (HL)
            LD      A, (IX+F_PMSAMS)
            AND     3
            LD      H, A
            LD      L, 0
            SRL     H
            RR      L
            LD      A, (AMD)
            ADD     A, L
            LD      L, A
            LD      DE, (H_AMS)
            ADD     HL, DE
            LD      A, (HL)
            OR      B
            LD      B, A
            LD      A, (IX+F_RL)
            AND     $40
            ADD     A, A
            LD      E, A
            LD      A, (IX+F_RL)
            AND     $80
            RRCA
            OR      E
            OR      B
            LD      E, A
            LD      D, $B4
            CALL    fmw
            POP     BC
            RET

lfo
            LD      A, (PMD)
            LD      E, A
            LD      A, (AMD)
            OR      E
            JR      Z, lf_off
            LD      A, (LFRQ)
            LD      E, A
            LD      D, 0
            LD      HL, (H_LFO)
            ADD     HL, DE
            LD      E, (HL)
            JR      lf_w
lf_off
            LD      E, 0
lf_w
            LD      D, $22
            JP      ymw0

; Pitch of IX source on target C.
pitch
            CALL    dac_poll
            LD      A, (IX+F_KC)
            AND     15
            LD      B, A
            SRL     A
            SRL     A
            LD      D, A
            LD      A, B
            SUB     D               ; semitone 0..12
            LD      H, 0
            LD      L, A
            ADD     HL, HL
            ADD     HL, HL
            ADD     HL, HL
            ADD     HL, HL
            ADD     HL, HL
            ADD     HL, HL
            LD      A, (IX+F_KF)
            RRCA
            RRCA
            AND     $3F
            ADD     A, L
            LD      L, A
            LD      A, (IX+F_KC)
            RRCA
            RRCA
            RRCA
            RRCA
            AND     7
            LD      B, A
            LD      A, H
            CP      3
            JR      C, pt_norm
            SUB     3
            LD      H, A
            INC     B
pt_norm
            LD      (PIDX), HL
            LD      A, B
            LD      (POCT), A
            LD      A, C
            CP      2
            JR      Z, pt_special
            CP      6
            JR      NC, pt_psg
            LD      E, A
            XOR     A
            LD      (FPORT), A
            LD      A, E
            CP      3
            JR      C, pt_regs
            SUB     3
            LD      E, A
            LD      A, 1
            LD      (FPORT), A
pt_regs
            LD      A, $A4
            ADD     A, E
            LD      (FHI), A
            LD      A, $A0
            ADD     A, E
            LD      (FLO), A
            JP      fmfreq
pt_special
            LD      HL, (PIDX)
            LD      (PBASE), HL
            LD      A, (POCT)
            LD      (PBOCT), A
            LD      B, 0
ps_op
            PUSH    BC
            LD      A, F_DT2
            ADD     A, B
            CALL    ixfield
            LD      A, (HL)
            ADD     A, A
            LD      E, A
            LD      D, 0
            LD      HL, (H_DT2P)
            ADD     HL, DE
            LD      E, (HL)
            INC     HL
            LD      D, (HL)
            LD      HL, (PBASE)
            ADD     HL, DE
            LD      A, (PBOCT)
            LD      C, A
            LD      A, H
            CP      3
            JR      C, ps_norm
            SUB     3
            LD      H, A
            INC     C
ps_norm
            LD      (PIDX), HL
            LD      A, C
            LD      (POCT), A
            LD      HL, speclow
            LD      E, B
            LD      D, 0
            ADD     HL, DE
            LD      A, (HL)
            LD      (FLO), A
            ADD     A, 4
            LD      (FHI), A
            XOR     A
            LD      (FPORT), A
            CALL    fmfreq
            POP     BC
            INC     B
            LD      A, B
            CP      4
            JR      NZ, ps_op
            RET
speclow
            DB      $A9, $A8, $AA, $A2
pt_psg
            LD      HL, (PIDX)
            ADD     HL, HL
            LD      DE, (H_PSG)
            ADD     HL, DE
            LD      E, (HL)
            INC     HL
            LD      D, (HL)         ; period at octave 0
            LD      A, (POCT)
            OR      A
            JR      Z, pp_clamp
            LD      B, A
            LD      HL, 1           ; round: + (1 << oct) >> 1
            DEC     A
            JR      Z, pp_round
pp_rl
            ADD     HL, HL
            DEC     A
            JR      NZ, pp_rl
pp_round
            ADD     HL, DE
            EX      DE, HL
pp_sh
            SRL     D
            RR      E
            DJNZ    pp_sh
pp_clamp
            LD      A, D
            CP      4
            JR      C, pp_ok
            SRL     D
            RR      E
            JR      pp_clamp
pp_ok
            LD      A, C
            SUB     16
            RRCA
            RRCA
            RRCA
            LD      B, A
            LD      A, E
            AND     15
            OR      B
            OR      $80
            CALL    psgw
            LD      A, E
            RRCA
            RRCA
            RRCA
            RRCA
            AND     $0F
            LD      E, A
            LD      A, D
            RLCA
            RLCA
            RLCA
            RLCA
            AND     $30
            OR      E
            JP      psgw

; Block/F-number from PIDX/POCT to FHI/FLO on FPORT.
fmfreq
            CALL    dac_poll
            LD      HL, (PIDX)
            ADD     HL, HL
            LD      DE, (H_FN)
            ADD     HL, DE
            LD      E, (HL)
            INC     HL
            LD      D, (HL)
            LD      A, (POCT)
            CP      8
            JR      C, ff_ok
            SUB     7
            LD      B, A
ff_sh
            SLA     E
            RL      D
            DJNZ    ff_sh
            LD      A, D
            CP      8
            JR      C, ff_7
            LD      DE, $07FF
ff_7
            LD      A, 7
ff_ok
            ADD     A, A
            ADD     A, A
            ADD     A, A
            OR      D
            LD      (FVHI), A
            LD      A, E
            LD      (FVLO), A
            LD      A, (FHI)
            LD      D, A
            LD      A, (FVHI)
            LD      E, A
            CALL    ymwp
            LD      A, (FLO)
            LD      D, A
            LD      A, (FVLO)
            LD      E, A
ymwp
            LD      A, (FPORT)
            OR      A
            JP      Z, ymw0
            JP      ymw1

; ---- translator entry: source YM2151 write D = register, E = value ---------
opmw
            CALL    dac_poll
            LD      A, D
            CP      $08
            JR      NZ, ow_n08
            LD      A, E
            AND     7
            CALL    srcix
            LD      A, E
            RRCA
            RRCA
            RRCA
            AND     15
            LD      B, A            ; slot mask
            LD      A, (IX+F_TGT)
            CP      6
            JR      NC, ow_kpsg
            LD      C, A
            LD      HL, PENDON
            ADD     A, L
            LD      L, A
            LD      (HL), B
            LD      A, B
            OR      A
            RET     NZ
            CALL    keycode         ; key-off now; key-on waits for tick
            LD      E, A
            LD      D, $28
            CALL    ymw0
            LD      A, C
            CALL    bitmask
            LD      HL, OFFMASK
            OR      (HL)
            LD      (HL), A
            RET
ow_kpsg
            CP      $FF
            RET     Z
            LD      A, B
            OR      A
            JR      Z, ow_koff
            LD      (IX+F_STAGE), 1
            LD      (IX+F_ENV), 0
            LD      (IX+F_ENV+1), 0
            JP      psglevel
ow_koff
            LD      A, (IX+F_STAGE)
            OR      A
            JP      Z, psglevel
            LD      (IX+F_STAGE), 3
            JP      psglevel
ow_n08
            CP      $18
            JR      NZ, ow_n18
            LD      A, E
            LD      (LFRQ), A
            JP      lfo
ow_n18
            CP      $19
            JR      NZ, ow_n19
            LD      A, E
            BIT     7, A
            JR      Z, ow_amd
            AND     $7F
            LD      (PMD), A
            JR      ow_19b
ow_amd
            LD      (AMD), A
ow_19b
            CALL    lfo
            LD      B, 0
ow_pan
            LD      A, B
            CALL    srcix
            LD      A, (IX+F_TGT)
            CP      6
            JR      NC, ow_pan_n
            LD      C, A
            CALL    fmpan
ow_pan_n
            INC     B
            LD      A, B
            CP      8
            JR      NZ, ow_pan
            RET
ow_n19
            CP      $20
            RET     C
            AND     7
            CALL    srcix
            LD      A, (IX+F_TGT)
            CP      $FF
            RET     Z
            LD      C, A            ; target
            LD      A, D
            CP      $40
            JR      NC, ow_op
            AND     $F8
            CP      $20
            JR      NZ, ow_n20
            LD      (IX+F_RL), E
            LD      A, C
            CP      6
            JP      NC, psglevel
            LD      A, E
            AND     $3F
            LD      E, A
            LD      D, $B0
            CALL    fmw
            JP      fmpan
ow_n20
            CP      $28
            JR      NZ, ow_n28
            LD      (IX+F_KC), E
            JP      pitch
ow_n28
            CP      $30
            JR      NZ, ow_n30
            LD      (IX+F_KF), E
            JP      pitch
ow_n30
            LD      (IX+F_PMSAMS), E
            LD      A, C
            CP      6
            RET     NC
            JP      fmpan
; Operator registers: OPM M1,M2,C1,C2 (+0/+8/+16/+24) = YM2612 S1,S3,S2,S4
; (+0/+4/+8/+12): the operator index carries over directly.
ow_op
            LD      A, D
            RRCA
            RRCA
            RRCA
            AND     3
            LD      B, A            ; operator
            LD      A, D
            RLCA
            RLCA
            RLCA
            AND     7
            LD      (OPKIND), A     ; 2..7
            LD      A, C
            CP      6
            JR      NC, ow_opsg
            LD      A, (OPKIND)
            CP      2
            JR      NZ, ow_on2
            LD      A, F_DT1MUL
            ADD     A, B
            CALL    ixfield
            LD      (HL), E
            JR      ow_mul
ow_on2
            CP      6
            JR      NZ, ow_plain
            LD      A, F_DT2
            ADD     A, B
            CALL    ixfield
            LD      A, E
            RLCA
            RLCA
            AND     3
            LD      (HL), A
            LD      A, E
            AND     $1F
            LD      E, A
            LD      A, B
            ADD     A, A
            ADD     A, A
            ADD     A, $70
            LD      D, A
            CALL    fmw             ; DT2 has no YM2612 register
            LD      A, C
            CP      2
            JP      Z, pitch        ; special mode: exact per-operator pitch
            JR      ow_mul
ow_plain
            INC     A
            ADD     A, A
            ADD     A, A
            ADD     A, A
            ADD     A, A
            LD      D, A
            LD      A, B
            ADD     A, A
            ADD     A, A
            ADD     A, D
            LD      D, A
            JP      fmw
ow_mul
            LD      A, F_DT1MUL
            ADD     A, B
            CALL    ixfield
            LD      E, (HL)
            LD      A, B
            ADD     A, A
            ADD     A, A
            ADD     A, $30
            LD      D, A
            LD      A, C
            CP      2
            JP      Z, fmw          ; special: raw DT1/MUL
            PUSH    DE              ; fold DT2 ratio into MUL
            LD      A, F_DT2
            ADD     A, B
            CALL    ixfield
            LD      A, E
            AND     15
            ADD     A, A
            ADD     A, A
            ADD     A, (HL)
            LD      E, A
            LD      D, 0
            LD      HL, (H_DT2MUL)
            ADD     HL, DE
            LD      H, (HL)
            POP     DE
            LD      A, E
            AND     $70
            OR      H
            LD      E, A
            JP      fmw
ow_opsg
            LD      A, B
            CP      3               ; PSG voices follow the final carrier only
            RET     NZ
            LD      A, (OPKIND)
            CP      3
            JR      NZ, ow_p5
            LD      A, E
            AND     $7F
            LD      (IX+F_TL), A
            JP      psglevel
ow_p5
            CP      5
            JR      NZ, ow_p6
            LD      A, E
            AND     $1F
            LD      (IX+F_D1R), A
            RET
ow_p6
            CP      6
            JR      NZ, ow_p7
            LD      A, E
            AND     $1F
            LD      (IX+F_D2R), A
            RET
ow_p7
            CP      7
            RET     NZ
            LD      (IX+F_D1LRR), E
            RET

; ---- sequencer --------------------------------------------------------------
; Source write with registers kept: D = register, E = value.
w
            PUSH    BC
            PUSH    HL
            PUSH    IX
            CALL    opmw
            POP     IX
            POP     HL
            POP     BC
            RET

; A = channel -> E = (255 - (master*gain >> 8)) >> 1
attn
            LD      HL, CHGAIN
            ADD     A, L
            LD      L, A
            LD      E, (HL)
            LD      A, (MGAIN)
            PUSH    BC
            CALL    mul8
            POP     BC
            LD      A, 255
            SUB     H
            SRL     A
            LD      E, A
            RET

; A = selector -> HL = cursor, carry set if unavailable
lookup
            CP      TRACKCOUNT
            CCF
            RET     C
            ADD     A, A
            LD      E, A
            LD      D, 0
            LD      HL, (H_TRACKS)
            ADD     HL, DE
            LD      E, (HL)
            INC     HL
            LD      D, (HL)
            EX      DE, HL
            LD      DE, (H_EVCOUNT)
            OR      A
            SBC     HL, DE
            ADD     HL, DE
            CCF
            RET
; HL = cursor
install
            LD      (CURSOR), HL
            LD      A, $FF
            LD      (STATUS), A
            XOR     A
            LD      (IDLEDONE), A
            LD      HL, LOOPCNT
            LD      B, 8
in_l
            LD      (HL), A
            INC     HL
            DJNZ    in_l
            RET

service
            LD      A, (STATUS)
            OR      A
            JR      NZ, sv_busy
            LD      A, (IDLEDONE)   ; idle: mute outputs and final carriers
            OR      A
            RET     NZ
            INC     A
            LD      (IDLEDONE), A
            LD      B, 0
sv_idle1
            LD      A, $20
            ADD     A, B
            LD      D, A
            LD      E, 0
            CALL    w
            INC     B
            LD      A, B
            CP      8
            JR      NZ, sv_idle1
            LD      B, 0
sv_idle2
            LD      A, $78
            ADD     A, B
            LD      D, A
            LD      E, $7F
            CALL    w
            INC     B
            LD      A, B
            CP      8
            JR      NZ, sv_idle2
            RET
sv_busy
            CP      $FF
            JR      NZ, sv_install
            LD      A, (MULT)       ; tempo accumulator
            LD      E, A
            LD      A, (BASE)
            CALL    mul8
            LD      DE, (FRAC)
            ADD     HL, DE
            LD      (FRAC), HL
            RET     NC
            JR      sv_events
sv_install
            CALL    lookup
            JP      C, sv_invalid
            XOR     A
            LD      (RETDEPTH), A
            CALL    install
sv_events
            LD      HL, 1024
            LD      (BUDGET), HL
ev_loop
            CALL    dac_poll
            LD      HL, (BUDGET)
            LD      A, H
            OR      L
            JP      Z, sv_invalid
            DEC     HL
            LD      (BUDGET), HL
            LD      HL, (CURSOR)
            LD      DE, (H_EVCOUNT)
            OR      A
            SBC     HL, DE
            JP      NC, sv_invalid
            ADD     HL, DE
            PUSH    HL
            INC     HL
            LD      (CURSOR), HL
            POP     HL
            ADD     HL, HL
            ADD     HL, HL
            LD      DE, (H_EVENTS)
            ADD     HL, DE
            LD      A, (HL)
            LD      (EVB0), A
            INC     HL
            LD      A, (HL)
            LD      (EVMASK), A
            INC     HL
            LD      A, (HL)
            LD      (EVVAL), A
            INC     HL
            LD      A, (HL)
            LD      (EVIDX), A
            LD      L, A
            LD      A, (EVB0)
            RLCA
            RLCA
            RLCA
            AND     7
            LD      H, A
            LD      (EVIDXW), HL
            ADD     HL, HL
            ADD     HL, HL
            ADD     HL, HL
            LD      DE, (H_DATA)
            ADD     HL, DE
            LD      (EVDATA), HL
            LD      A, (EVB0)
            AND     $1F
            CP      20
            JP      NC, sv_invalid
            ADD     A, A
            LD      E, A
            LD      D, 0
            LD      HL, ev_table
            ADD     HL, DE
            LD      E, (HL)
            INC     HL
            LD      D, (HL)
            EX      DE, HL
            JP      (HL)
ev_table
            DW      ev_gain, ev_base, ev_mult, ev_chan, ev_chan, ev_gains
            DW      ev_chan, ev_chan, ev_chan, ev_lfo, ev_phase, ev_amp
            DW      ev_loop, ev_end, ev_call, ev_track, ev_jump, ev_yield
            DW      ev_repeat, ev_repeat

ev_gain
            LD      A, (EVVAL)
            LD      (MGAIN), A
            LD      B, 0
eg_l
            LD      A, B
            CALL    attn
            LD      A, $78
            ADD     A, B
            LD      D, A
            CALL    w
            INC     B
            LD      A, B
            CP      8
            JR      NZ, eg_l
            JP      ev_loop
ev_base
            LD      A, (EVVAL)
            LD      (BASE), A
            LD      HL, 0
            LD      (FRAC), HL
            JP      ev_loop
ev_mult
            LD      A, (EVVAL)
            LD      (MULT), A
            JP      ev_loop
needdata
            LD      HL, (EVIDXW)
            LD      A, H
            CP      7
            RET     NZ
            LD      A, L
            CP      $FF
            RET     NZ
            POP     HL              ; drop return, abort
            JP      sv_invalid
ev_gains
            CALL    needdata
            LD      B, 7            ; source applies gains in descending order
eq_l
            CALL    dac_poll
            LD      A, B
            CALL    bitmask
            LD      HL, EVMASK
            AND     (HL)
            JR      Z, eq_n
            LD      HL, (EVDATA)
            LD      E, B
            LD      D, 0
            ADD     HL, DE
            LD      A, (HL)
            LD      HL, CHGAIN
            LD      E, B
            ADD     HL, DE
            LD      (HL), A
            LD      A, B
            CALL    attn
            LD      A, $78
            ADD     A, B
            LD      D, A
            CALL    w
eq_n
            DEC     B
            JP      P, eq_l
            JP      ev_loop
ev_chan
            CALL    needdata
            LD      B, 0
ec_l
            CALL    dac_poll
            LD      A, B
            CALL    bitmask
            LD      HL, EVMASK
            AND     (HL)
            JP      Z, ec_n
            LD      HL, (EVDATA)
            LD      E, B
            LD      D, 0
            ADD     HL, DE
            LD      C, (HL)         ; per-channel value
            LD      A, (EVB0)
            AND     $1F
            CP      4
            JR      Z, ec_instr
            CP      3
            JR      Z, ec_note
            CP      7
            JR      Z, ec_pitch
            CP      6
            JR      Z, ec_frac
            LD      A, C            ; 8: modulation
            AND     $73
            LD      E, A
            LD      A, $38
            JR      ec_wr
ec_frac
            LD      A, C
            AND     $FC
            LD      E, A
            LD      A, $30
            JR      ec_wr
ec_pitch
            LD      A, C
            CP      $FF
            JR      Z, ec_n
            LD      E, A
            LD      A, $28
ec_wr
            ADD     A, B
            LD      D, A
            CALL    w
            JR      ec_n
ec_note
            LD      D, $08
            LD      E, B
            CALL    w
            LD      A, C
            CP      $FF
            JR      Z, ec_n
            LD      E, A
            LD      A, $28
            ADD     A, B
            LD      D, A
            CALL    w
            LD      A, B
            OR      $78
            LD      E, A
            LD      D, $08
            CALL    w
            JR      ec_n
ec_instr
            LD      A, C            ; patch number -> 28 source registers
            CP      $FF
            JR      Z, ec_n
            ADD     A, A
            LD      E, A
            LD      D, 0
            LD      HL, (H_PATCHES)
            ADD     HL, DE
            LD      E, (HL)
            INC     HL
            LD      D, (HL)
            LD      (PATCHPTR), DE
            LD      A, $20
            ADD     A, B
            LD      C, 28
ei_l
            LD      D, A            ; register (A is clobbered by the poll)
            CALL    dac_poll
            LD      HL, (PATCHPTR)
            LD      E, (HL)
            INC     HL
            LD      (PATCHPTR), HL
            PUSH    DE
            CALL    w
            POP     DE
            LD      A, D
            ADD     A, 8
            DEC     C
            JR      NZ, ei_l
ec_n
            INC     B
            LD      A, B
            CP      8
            JP      NZ, ec_l
            LD      A, (EVB0)
            AND     $1F
            CP      3
            RET     Z               ; notes yield
            JP      ev_loop
ev_lfo
            LD      D, $18
            LD      A, (EVVAL)
            LD      E, A
            CALL    w
            JP      ev_loop
ev_phase
            LD      A, (EVVAL)
            OR      $80
            JR      ev_19
ev_amp
            LD      A, (EVVAL)
            AND     $7F
ev_19
            LD      E, A
            LD      D, $19
            CALL    w
            JP      ev_loop
ev_end
            LD      A, (RETDEPTH)
            OR      A
            JR      NZ, ee_ret
            LD      (STATUS), A     ; terminal end
            RET
ee_ret
            DEC     A
            LD      (RETDEPTH), A
            LD      HL, (RETCUR)
            LD      (CURSOR), HL
            JP      ev_loop
ev_call
            LD      A, (EVVAL)
            CALL    lookup
            JP      C, sv_invalid
            LD      DE, (CURSOR)
            LD      (RETCUR), DE
            LD      A, (RETDEPTH)
            INC     A
            LD      (RETDEPTH), A
            CALL    install
            JP      ev_loop
ev_track
            LD      A, (EVVAL)
            CALL    lookup
            JP      C, sv_invalid
            CALL    install
            JP      ev_loop
ev_jump
            LD      A, (EVVAL)
            LD      L, A
            LD      A, (EVMASK)
            LD      H, A
            LD      (CURSOR), HL
            JP      ev_loop
ev_yield
            RET
; Counted loops (MCU $850C/$8565).
ev_repeat
            CALL    needdata
            LD      A, (EVB0)
            AND     $1F
            SUB     19
            JR      Z, er_c
            LD      A, 0
            JR      er_c2
er_c
            LD      A, 1
er_c2
            LD      (RCOND), A
            LD      HL, (EVDATA)
            LD      E, (HL)
            INC     HL
            LD      D, (HL)
            INC     HL
            LD      (RFIRST), DE
            LD      E, (HL)
            INC     HL
            LD      D, (HL)
            LD      (RREPEAT), DE
            LD      HL, (CURSOR)
            DEC     HL
            LD      (RKEY), HL
            XOR     A
            LD      (RFOUND), A
            LD      A, (LASTLOOP)
            LD      C, A            ; last
            LD      B, 0            ; slot
er_scan
            CALL    dac_poll
            LD      HL, LOOPCNT
            LD      E, B
            LD      D, 0
            ADD     HL, DE
            LD      A, (HL)
            OR      A
            JR      NZ, er_used
            LD      C, B
            JR      er_next
er_used
            LD      HL, LOOPKEY
            ADD     HL, DE
            ADD     HL, DE
            LD      E, (HL)
            INC     HL
            LD      D, (HL)
            LD      HL, (RKEY)
            OR      A
            SBC     HL, DE
            JR      NZ, er_next
            LD      C, B
            LD      A, 1
            LD      (RFOUND), A
            JR      er_done
er_next
            INC     B
            LD      A, B
            CP      8
            JR      NZ, er_scan
er_done
            LD      A, C
            LD      (LASTLOOP), A
            LD      E, C
            LD      D, 0
            LD      HL, LOOPCNT
            ADD     HL, DE
            LD      A, (RFOUND)
            OR      A
            JR      NZ, er_found
            LD      (HL), 1
            LD      HL, LOOPKEY
            ADD     HL, DE
            ADD     HL, DE
            LD      DE, (RKEY)
            LD      (HL), E
            INC     HL
            LD      (HL), D
            LD      A, (RCOND)
            OR      A
            JR      NZ, er_next_c
            LD      HL, (RFIRST)
            JR      er_set
er_found
            INC     (HL)
            LD      A, (EVVAL)
            CP      (HL)
            JR      NZ, er_again
            LD      (HL), 0
            LD      A, (RCOND)
            OR      A
            JR      Z, er_next_c
            LD      HL, (RFIRST)
            JR      er_set
er_again
            LD      A, (RCOND)
            OR      A
            JR      NZ, er_next_c
            LD      HL, (RREPEAT)
            JR      er_set
er_next_c
            LD      HL, (CURSOR)
er_set
            LD      (CURSOR), HL
            JP      ev_loop

sv_invalid
            XOR     A
            LD      (STATUS), A
            LD      (ACTIVE), A
            JP      silence
